image:
  repository: docker.io/farberg/apache-hadoop
  tag: 3.4.1
  pullPolicy: IfNotPresent

hadoopVersion: 3.4.1
logLevel: INFO
antiAffinity: "soft"

hdfs:
  nameNode:
    resources:
      requests:
        memory: "256Mi"
        cpu: "100m"
      limits:
        memory: "2048Mi"
        cpu: "1000m"
  dataNode:
    replicas: {{ replicas }}
    resources:
      requests:
        memory: "256Mi"
        cpu: "100m"
      limits:
        memory: "2048Mi"
        cpu: "1000m"

yarn:
  nodeManager:
    replicas: {{ replicas }}
    resources:
      requests:
        memory: "512Mi"
        cpu: "200m"
      limits:
        memory: "2048Mi"
        cpu: "1000m"

persistence:
  nameNode:
    enabled: false
    storageClass: "-"
    size: 5Gi
  dataNode:
    enabled: false
    storageClass: "-"
    size: 10Gi
